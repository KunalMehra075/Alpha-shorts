# ─────────────────────────────────────────────────────────────
#  ElevenLabs configuration (required)
# ─────────────────────────────────────────────────────────────

# Your ElevenLabs API key. Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice + model are NOT configured here.
#   - Voices live in config/voices.json and are chosen in the dashboard's
#     Audio Generator (voice selector). The CLI falls back to the default
#     voiceId in config/default.json.
#   - The TTS model defaults to eleven_multilingual_v2 (config/default.json).
# (Setting ELEVENLABS_VOICE_ID / ELEVENLABS_MODEL_ID still overrides, but is
#  no longer required.)

# ─────────────────────────────────────────────────────────────
#  Optional overrides (safe defaults exist in config/default.json)
# ─────────────────────────────────────────────────────────────

# Content language.
# Prefer choosing language PER COMMAND instead of here:
#   npm run gen-caption <name>       -> English (default, whisper model: base)
#   npm run gen-caption:hi <name>    -> Hindi   (whisper model: small, preset: hindi)
# (the :hi/:en scripts pass a -hi/-en flag; the flag overrides this env value).
# Set this only if you want a different default when no flag is given:
#   en | hi | auto   (auto = let Whisper auto-detect)
# LANGUAGE=en

# Output audio format requested from ElevenLabs.
# e.g. mp3_44100_128, mp3_44100_192 (192 needs a paid tier), mp3_22050_32
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Whisper model size: tiny | base | small | medium | large | large-v3
# Leave unset to auto-pick by language (en->base, hi->small). Set to force one.
# WHISPER_MODEL=small

# Override the transcription language for Whisper only (ISO code, e.g. en, hi).
# By default Whisper follows the selected language. Set to "auto" or leave blank
# to force auto-detection.
# WHISPER_LANGUAGE=hi

# Which Whisper CLI binary to call.
#   whisper                -> the official openai-whisper package
#   whisper-ctranslate2    -> faster-whisper drop-in (same CLI flags)
# WHISPER_BIN=whisper

# Force a caption style preset (otherwise picked automatically by language).
#   English: hormozi | tiktok | minimal    Hindi: hindi | hindi-minimal
# CAPTION_STYLE=hormozi

# Background mode for the caption video:
#   transparent -> .mov with alpha (default)   greenscreen -> .mp4 on #00FF00
# Or per run: npm run gen-caption:green <name>  /  ... -- <name> --green
# VIDEO_BACKGROUND=transparent

# Path to the ffmpeg / ffprobe binaries. Leave unset to use the ones on PATH.
# IMPORTANT (macOS/Homebrew): the regular "ffmpeg" formula is built WITHOUT
# libass, so it cannot render captions. Install "ffmpeg-full" and point here:
#   brew install ffmpeg-full
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# ─────────────────────────────────────────────────────────────
#  Script generation LLM (dashboard Script Generator)
#  Strategy order: DeepSeek (first) -> OpenAI -> built-in mock fallback.
#  Configure either or both; the first available one that succeeds wins.
# ─────────────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
#  Automated video generation (Remotion) — npm run generate-video
# ─────────────────────────────────────────────────────────────

# Stock asset providers. At least one is recommended; without any key the
# pipeline falls back to your local assets/library/ and procedural animation
# scenes (it never fails the render).
# Pexels:  https://www.pexels.com/api/   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional background music. Drop a track in music/ and reference it by filename.
# Narration always stays primary; this plays underneath at a low volume.
# VIDEO_GEN_MUSIC=ambient.mp3
# VIDEO_GEN_MUSIC_VOLUME=0.12
